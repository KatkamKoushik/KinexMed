<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEvidenceRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#161B26"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Exercise & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardRepTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rep #7 · Bilateral Squat"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REJECTED"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_badge_amber" />
        </LinearLayout>

        <!-- Metric Comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Measured: "
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCardMeasuredAngle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="68°"
                android:textColor="#F59E0B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  Target: "
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCardTargetAngle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="≥ 90°"
                android:textColor="#06B6D4"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Rejection / Validation Reason -->
        <TextView
            android:id="@+id/tvCardReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Insufficient flexion depth (short of 90° target)"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <!-- Evidence Screenshot Thumbnail (optional) -->
        <ImageView
            android:id="@+id/ivEvidenceThumbnail"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:background="#0A0E17"
            android:contentDescription="Evidence Frame Screenshot" />

        <!-- Footer: Timestamp & Video Segment Tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCardTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sep 22, 2026 · 14:32:05"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCardVideoSeekTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to Inspect Rep ➔"
                android:textColor="#06B6D4"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
