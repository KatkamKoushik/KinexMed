<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F141E"
    android:padding="20dp">

    <!-- Dialog Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Repetition Kinematic Inspection"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogSessionSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Bilateral Squat · 10 Reps"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#1E293B" />

    <!-- Repetitions List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDialogReps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="380dp" />

    <TextView
        android:id="@+id/tvNoRepsRecorded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        android:gravity="center"
        android:text="No repetition movements logged in this session."
        android:textColor="#64748B"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Dialog Actions -->
    <Button
        android:id="@+id/btnDialogClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Close Inspection"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#1E293B"
        app:cornerRadius="8dp" />
</LinearLayout>
