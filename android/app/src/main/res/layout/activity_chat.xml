<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E">

    <!-- Top AppBar / Header -->
    <LinearLayout
        android:id="@+id/chatHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="28dp"
        android:paddingBottom="12dp"
        android:background="#0D111A"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REHABILITATION MEMORY"
                android:textColor="#06B6D4"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local Room SQLite · 100% Offline"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClearChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Clear Chat History" />
    </LinearLayout>

    <!-- Quick Prompt Suggestions (Horizontal ScrollView) -->
    <HorizontalScrollView
        android:id="@+id/hsvSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:background="#0A0E17"
        app:layout_constraintTop_toBottomOf="@id/chatHeaderLayout">

        <LinearLayout
            android:id="@+id/llPromptChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipWhyRep7"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Why wasn't my 7th rep counted?"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />

            <Button
                android:id="@+id/chipRejectedYesterday"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Show rejected reps from yesterday"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />

            <Button
                android:id="@+id/chipValidThisWeek"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="How many valid reps this week?"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />

            <Button
                android:id="@+id/chipSummaryMonth"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Summary of this month"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />

            <Button
                android:id="@+id/chipWhichExercise"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Which exercise did I perform most?"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />

            <Button
                android:id="@+id/chipExplainToday"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Explain today's session simply"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />

            <Button
                android:id="@+id/chipLastSession"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="What happened during my last session?"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:backgroundTint="#161B26" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/hsvSuggestions"
        app:layout_constraintBottom_toTopOf="@id/chatInputLayout" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutChatEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/hsvSuggestions"
        app:layout_constraintBottom_toTopOf="@id/chatInputLayout">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Rehabilitation Assistant"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ask questions about your recorded repetitions, rejection reasons, ROM angles, or weekly summaries above."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/chatInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="#0D111A"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#161B26"
            android:hint="Ask about your sessions or reps..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textSize="14sp"
            android:maxLines="3"
            android:inputType="textCapSentences|textMultiLine" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Ask"
            android:textColor="#FFFFFF"
            android:backgroundTint="#06B6D4" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
