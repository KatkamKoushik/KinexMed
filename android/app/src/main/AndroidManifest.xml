<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KinexMed">

        <!-- Launcher Activity: Patient Home & Exercise Selection -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exercise Preparation & Positioning Checklist -->
        <activity
            android:name=".ui.ExercisePreparationActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Live Camera Biofeedback & Kinematic State Machine Tracking -->
        <activity
            android:name=".ui.ExerciseActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize" />

        <!-- Local Session History & Repetition Inspection -->
        <activity
            android:name=".ui.SessionHistoryActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Settings, Device Connectivity & Clinical Guide -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Personal Rehabilitation Memory & Chat Assistant -->
        <activity
            android:name=".ui.ChatActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Exercise Learning & Instructions Screen ("Learn" Stage) -->
        <activity
            android:name=".ui.ExerciseDetailActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Weekly & Monthly Progress Screen -->
        <activity
            android:name=".ui.ProgressActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Post-Session Summary & Review Screen -->
        <activity
            android:name=".ui.SessionSummaryActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

        <!-- Personalized Exercise Plans Management -->
        <activity
            android:name=".ui.PlansActivity"
            android:exported="true"
            android:screenOrientation="portrait" />

    </application>

</manifest>
